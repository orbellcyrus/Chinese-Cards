<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link
        rel="stylesheet"
        href="/css/style.css">
</head>
<body>
    <nav class="navbar">
        <div class="logo">
            MySite
        </div>
        <ul class="navLinks">
            <li><a href="/">Home</a></li>
            <li><a href="/dictionary">Dictionary</a></li>
            <li><a href="/account">Account</a></li>
            <li><a href="/decks">Decks</a></li>
        </ul>
    </nav>

    <div class = "dictionaryPage">
        
        <h1>Characters</h1> 
        <input class = "dictionarySearchBar"id = "searchBar" placeholder = "Search characters">
        <table class = "dictionaryTable">
            <thead>
                <tr>
                    <th>Character / 汉子</th>
                    <th>English</th>
                    <th>Pronunciation / 拼音</th>
                    <th>Known</th>
                </tr>
            </thead>
            <tbody>
                <% characters.forEach(character =>{ %>
                    <tr class = "dictionaryRow">
                        <td>
                            <%= character.chinese_character %>
                        </td>

                        <td>
                            <%= character.english %>
                        </td>

                        <td>
                            <%= character.pronunciation %>
                        </td>

                        <td>
                            <% if(character.known){ %>
                                <form
                                    action="/unlearnCharacter"
                                    method="POST">
                                    <input
                                        type="hidden"
                                        name="characterId"
                                        value="<%= character.id %>">
                                    <button>
                                       ✅ Click To Unlearn
                                    </button>
                                </form>
                            <% } else { %>
                                <form
                                    action="/learnCharacter"
                                    method="POST">

                                    <input
                                        type="hidden"
                                        name="characterId"
                                        value="<%= character.id %>">
                                    <button>
                                        ❌ Click To Learn
                                    </button>
                                </form>
                            <% } %>
                        </td>
                    </tr>
                <% }) %>
                
            </tbody>
            

        </table>

    </div>
   

</body>
<script>
    

    const searchBar = document.getElementById("searchBar");
    searchBar.addEventListener("input",()=>{
        const search = searchBar.value.toLowerCase();
        const rows = document.querySelectorAll(".characterRow");
        rows.forEach(row=>{
            const text = row.innerText.toLowerCase();
            if(text.includes(search)){
                row.style.display="";
            }else{
                row.style.display= "none";
            }
        })
    })
   
   
</script>

</html>

