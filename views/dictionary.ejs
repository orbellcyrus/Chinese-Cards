<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link
        rel="stylesheet"
        href="/css/style.css">
</head>
<body>
    <nav class="navbar">
        <div class="logo">
            MySite
        </div>
        <ul class="navLinks">
            <li><a href="/">Home</a></li>
            <li><a href="/dictionary">Dictionary</a></li>
            <li><a href="/account">Account</a></li>
            <li><a href="/decks">Decks</a></li>
        </ul>
    </nav>

    <div class = "dictionaryPage">
        
        <h1>Characters</h1> 
        <% for(i in)%>
        <div class="dictionaryPages">
            <a href="?sort=<%=sort%>&page=1">
                1
            </a>

            <a href="?sort=<%=sort%>&page=2">
                2
            </a>
            
        </div>
        
        <input class = "dictionarySearchBar"id = "searchBar" placeholder = "Search characters">
        <table class = "dictionaryTable">
            <tr>
                <th class="charColumn">
                    <a href="?sort=chinese_character&page=1">
                        Character / 汉子
                    </a>
                </th>
                <th class = "englishColumn">
                    <a href="?sort=english&page=1">
                        English
                    </a>
                </th>
                <th class = "pronunciationColomn">
                    <a href ="?sort=pronunciation&page=1">
                        Pronunciation / 拼音
                    </a>
                </th>
                <th>
                    <a href ="?sort=known&page=1">
                        Known
                    </a>
                </th>
          
                <th class ="correctColumn">
                    <a href ="?sort=correct&page=<1">
                         Times Correct In Flash Cards
                    </a>
                </th>
            </tr>
            
        
            <% characters.forEach(character =>{ %>
                <tr class = "dictionaryRow">
                    <td>
                        <%= character.chinese_character %>
                    </td>

                    <td>
                        <%= character.english %>
                    </td>

                    <td>
                        <%= character.pronunciation %>
                    </td>

                    <td>
                        <% if(character.known){ %>
                            
                            <button class="toggleLearnButton"
                                    data-character-id = "<%= character.id %>"
                                    data-known = "true"
                            >
                                ✅ Click To Unlearn
                            </button>
                           
                        <% } else { %>
                            
                            <button class="toggleLearnButton"
                                    data-character-id = "<%= character.id %>"
                                    data-known = "false"
                            >
                                ❌ Click To Learn
                            </button>
                            
                        <% } %>
                    </td>
                    <td>
                        <%=character.correct %>
                    </td>
                </tr>
            <% }) %>
                
           
            

        </table>

    </div>
   

</body>
<script>
    
    document.querySelectorAll(".toggleLearnButton").forEach(button => {
        button.addEventListener("click",()=>{
            const characterId=button.dataset.characterId;
            const known = button.dataset.known === "true"

            fetch(known?"/unlearnCharacter":"/learnCharacter",{
                method:"POST",
                headers:{
                    "Content-Type":"application/json"
                },
                body: JSON.stringify({
                    characterId
                })
            }).then(()=>{
                if(known){
                    button.innerText = "❌ Click To Learn";
                    button.dataset.known = "false";

                }else{
                    button.innerText = "✅ Click To Unlearn";
                    button.dataset.known = "true"


                }
            })
        })
    })
    

    const searchBar = document.getElementById("searchBar");
    searchBar.addEventListener("input",()=>{
        const search = searchBar.value.toLowerCase();
        const rows = document.querySelectorAll(".dictionaryRow");
        rows.forEach(row=>{
            const text = row.innerText.toLowerCase();
            if(text.includes(search)){
                row.style.display="";
            }else{
                row.style.display= "none";
            }
        })
    })

    console.log(<%pageNumber%>);
   
   
</script>

</html>

