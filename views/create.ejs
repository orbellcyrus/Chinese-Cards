<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="navbar">
        <div class="logo">
            MySite
        </div>
        <ul class="navLinks">
            <li><a href="/">Home</a></li>
            <li><a href="/dictionary">Dictionary</a></li>
            <li><a href="/account">Account</a></li>
            <li><a href="/decks">Decks</a></li>
        </ul>
    </nav>
    <div class = "createCharacterLayout">
        <div class ="panel">
            <h2>
                In Deck
            </h2>
            <input class ="createSearchBar" id ="deckSearch" placeholder="Search deck">
            <div class = "deckCurrentCharacters">
                <% deckChars.forEach(character=>{%>
                    <div class ="createPageCharacterRow">
                        <p>
                            <%= character.chinese_character %> - <%=character.english%> -  <%=character.pronunciation%>
                        </p>
                        <button class = "removeButton" data-character-id = "<%=character.id%>">
                            Remove
                        </button>

                    </div>
                <% }) %>
            </div>
        </div>

        <div class ="panel">
            <h2>
                Available Characters
            </h2>
            <input class ="createSearchBar" id ="allSearch" placeholder="Search Characters">
            <div class = "deckNewCharacters">
                <% allChars.forEach(character=>{%>
                    <div class ="createPageCharacterRow">
                        <button class = "addButton" data-character-id = "<%=character.id%>">
                            Add
                        </button>
                        <p>
                            <%= character.chinese_character %> - <%=character.english%> -  <%=character.pronunciation%>
                        </p>
                       

                    </div>
                <% }) %>
            </div>
        </div>

        

    </div>



    
        
    

</body>

<script>

    function addChar(characterId, row) {
        fetch("/addCharacterToDeck", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ deckId: <%= deck.id %>, characterId })
        })
        .then(() => {
            const clone = row.cloneNode(true);

            // Swap the button class and text
            const btn = clone.querySelector("button");
            btn.className = "removeButton";
            btn.textContent = "Remove";

            // Attach the new listener
            btn.addEventListener("click", () => {
                removeChar(characterId, clone);
            });

            document.querySelector(".deckCurrentCharacters").appendChild(clone);
            row.remove();
        });
    }

    function removeChar(characterId, row) {
        fetch("/removeCharacterFromDeck", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ deckId: <%= deck.id %>, characterId })
        })
        .then(() => {
            const clone = row.cloneNode(true);

            // Swap the button class and text
            const btn = clone.querySelector("button");
            btn.className = "addButton";
            btn.textContent = "Add";

            // Attach the new listener
            btn.addEventListener("click", () => {
                addChar(characterId, clone);
            });

            document.querySelector(".deckNewCharacters").appendChild(clone);
            row.remove();
        });
    }

    // Initial listeners for server-rendered buttons
    document.querySelectorAll(".addButton").forEach(button => {
        button.addEventListener("click", () => {
            addChar(button.dataset.characterId, button.closest(".createPageCharacterRow"));
        });
    });

    document.querySelectorAll(".removeButton").forEach(button => {
        button.addEventListener("click", () => {
            removeChar(button.dataset.characterId, button.closest(".createPageCharacterRow"));
        });
    });




    function setupSearch(inputId, containerClass){
        const input = document.getElementById(inputId);
        input.addEventListener("input",()=>{
            const search = input.value.toLowerCase();
            const rows = document.querySelectorAll(`.${containerClass} .createPageCharacterRow`);
            rows.forEach(row=>{
                const text = row.innerText.toLowerCase();
                row.style.display = text.includes(search) ? "flex" : "none";
            });
        });
    }
    setupSearch("deckSearch","deckCurrentCharacters");

    setupSearch("allSearch","deckNewCharacters");

</script>


</html>